" colorscheme
autocmd ColorScheme * highlight Normal ctermbg=NONE guibg=NONE
set termguicolors
set background=dark

" Status line & tabline
set laststatus=2
set showtabline=2
set cursorline

set smartindent
set hlsearch
set incsearch
" set number
" set signcolumn=yes

" General settings
set mouse=ar
set clipboard+=unnamedplus

set tabstop=4
set shiftwidth=4
set expandtab
